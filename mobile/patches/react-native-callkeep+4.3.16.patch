+    static dispatch_queue_t queue;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        queue = dispatch_queue_create("io.wazo.callkeep.audiosession", DISPATCH_QUEUE_SERIAL);
+    });
+    return queue;
+}
